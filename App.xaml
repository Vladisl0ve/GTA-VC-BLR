<Application x:Class="GTA_GXT_Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="CheckBoxBackground" Color="{StaticResource SubtleFillColorTransparent}" />
            <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{StaticResource SubtleFillColorTransparent}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
