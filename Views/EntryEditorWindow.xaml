<Window x:Class="GTA_GXT_Editor.Views.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GTA_GXT_Editor.Localization"
        Width="900"
        Height="760"
        MinWidth="680"
        MinHeight="560"
        MaxHeight="900"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="OccurrencesRow" Height="1.4*" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{loc:Translate Main.Key}" />
            <TextBox x:Name="NameTextBox"
                     Grid.Column="1"
                     MaxLength="8"
                     Padding="10,6"
                     VerticalContentAlignment="Center" />
        </Grid>

        <Grid x:Name="SourcePanel" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,7,0,0" VerticalAlignment="Top" Text="{loc:Translate Main.EnglishSource}" />
            <TextBox x:Name="SourceTextBox"
                     Grid.Column="1"
                     MinHeight="70"
                     MaxHeight="130"
                     Padding="10,7"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,7,0,0" VerticalAlignment="Top" Text="{loc:Translate Main.Translation}" />
            <TextBox x:Name="ValueTextBox"
                     Grid.Column="1"
                     MinHeight="100"
                     Padding="10,7"
                     AcceptsReturn="True"
                     SpellCheck.IsEnabled="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Grid x:Name="TablePanel" Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{loc:Translate Main.Table}" />
            <ComboBox x:Name="TableComboBox"
                      Grid.Column="1"
                      Padding="8,5"
                      DisplayMemberPath="DisplayName" />
        </Grid>

        <Grid x:Name="OccurrencesPanel" Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,7,0,0" VerticalAlignment="Top" Text="{loc:Translate Main.Occurrences}" />
            <DataGrid x:Name="OccurrencesGrid"
                      Grid.Column="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="1.1*" Header="{loc:Translate Main.Block}" Binding="{Binding BlockName}" />
                    <DataGridTextColumn Width="90" Header="{loc:Translate Main.Order}" Binding="{Binding OrderText}" />
                    <DataGridTextColumn Width="1.4*" Header="{loc:Translate Main.Context}" Binding="{Binding Context}" />
                    <DataGridTextColumn Width="90" Header="{loc:Translate Main.Source}" Binding="{Binding SourceName}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,7,0,0" VerticalAlignment="Top" Text="{loc:Translate Main.Comment}" />
            <TextBox x:Name="CommentTextBox"
                     Grid.Column="1"
                     MinHeight="70"
                     Padding="10,7"
                     AcceptsReturn="True"
                     SpellCheck.IsEnabled="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="110"
                    Margin="0,0,8,0"
                    Padding="14,7"
                    IsCancel="True"
                    Content="{loc:Translate Common.Cancel}" />
            <Button x:Name="SaveButton"
                    MinWidth="130"
                    Padding="14,7"
                    IsDefault="True"
                    Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
