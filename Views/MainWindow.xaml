<Window x:Class="GTA_GXT_Editor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GTA_GXT_Editor.Localization"
        Title="{loc:Translate App.Name}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="720"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding ImportJsonCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportJsonCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ApplyFilterCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/MainWindowCommandStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Grid x:Name="OpenFileSplitButton" Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button MinWidth="91"
                            Style="{StaticResource SplitPrimaryButtonStyle}"
                            Content="{loc:Translate Main.Open}"
                            ToolTip="{loc:Translate Main.Open.ToolTip}"
                            Command="{Binding OpenFileCommand}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SplitChevronButtonStyle}"
                            Tag="{Binding ElementName=OpenFileSplitButton}"
                            ToolTip="{loc:Translate Main.Open.More}"
                            Click="DropDownButton_OnClick">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource CommandContextMenuStyle}"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                          Header="{loc:Translate Main.Open.WithMapping}"
                                          Command="{Binding OpenFileWithDictionaryCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <Button MinWidth="140"
                        Margin="8,0,0,0"
                        Style="{StaticResource DropDownButtonStyle}"
                        Content="{loc:Translate Main.Import}"
                        ToolTip="{loc:Translate Main.Import.ToolTip}"
                        Click="DropDownButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource CommandContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ImportJson}"
                                      InputGestureText="Ctrl+Shift+I"
                                      Command="{Binding ImportJsonCommand}" />
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ImportJson.WithMapping}"
                                      Command="{Binding ImportJsonWithDictionaryCommand}" />
                            <Separator />
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ImportComments}"
                                      Command="{Binding ImportCommentsCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button MinWidth="140"
                        Margin="8,0,0,0"
                        Style="{StaticResource DropDownButtonStyle}"
                        Content="{loc:Translate Main.SaveAs}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="{loc:Translate Main.SaveAs.ToolTip}"
                        Click="DropDownButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource CommandContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.SaveCurrent}"
                                      InputGestureText="Ctrl+S"
                                      Command="{Binding SaveCommand}" />
                            <Separator />
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.SaveProjectAs}"
                                      Command="{Binding SaveProjectAsCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button MinWidth="140"
                        Margin="8,0,0,0"
                        Style="{StaticResource DropDownButtonStyle}"
                        Content="{loc:Translate Main.ExportAs}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="{loc:Translate Main.ExportAs.ToolTip}"
                        Click="DropDownButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource CommandContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ExportJson}"
                                      InputGestureText="Ctrl+Shift+E"
                                      Command="{Binding ExportJsonCommand}" />
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ExportGxt}"
                                      Command="{Binding ExportGxtCommand}" />
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ExportInstaller}"
                                      Command="{Binding ExportInstallerCommand}" />
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ExportComments}"
                                      Command="{Binding ExportCommentsCommand}" />
                            <Separator />
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.ExportTxd}"
                                      Command="{Binding ExportTxdCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button MinWidth="116"
                        Margin="8,0,0,0"
                        Style="{StaticResource DropDownButtonStyle}"
                        Content="{loc:Translate Settings.Button}"
                        ToolTip="{loc:Translate Settings.ToolTip}"
                        Click="DropDownButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource CommandContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Settings.InterfaceLanguage}"
                                      ItemsSource="{Binding SupportedUiLanguages}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="{x:Type MenuItem}"
                                           BasedOn="{StaticResource CommandMenuItemStyle}">
                                        <Setter Property="Header" Value="{Binding NativeName}" />
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <EventSetter Event="Click" Handler="LanguageMenuItem_OnClick" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{loc:Translate App.Name}" />
                <TextBlock Margin="0,4,0,0"
                           Opacity="0.7"
                           Text="{loc:Translate App.Tagline}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="{loc:Translate Main.GxtFile}" />
            <TextBox Grid.Column="1"
                     MinHeight="34"
                     Padding="10,6"
                     IsReadOnly="True"
                     Text="{Binding GxtPath}" />
            <Border Grid.Column="2"
                    Margin="10,0,0,0"
                    Padding="12,6"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <TextBlock VerticalAlignment="Center" Text="{Binding DocumentType}" />
            </Border>
            <Button Grid.Column="3"
                    MinWidth="110"
                    Margin="10,0,0,0"
                    Padding="12,6"
                     Content="{loc:Translate Main.Reload}"
                     Command="{Binding ReloadCommand}" />

            <TextBlock Grid.Row="1"
                       Margin="0,10,10,0"
                       VerticalAlignment="Center"
                       Text="{loc:Translate Main.ByxProject}" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="3"
                     Margin="0,10,0,0"
                     MinHeight="34"
                     Padding="10,6"
                     IsReadOnly="True"
                     ToolTip="{loc:Translate Main.ByxProject.Empty.ToolTip}"
                     Text="{Binding ProjectPath}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{loc:Translate Main.TxdFonts}" />
                <TextBox Grid.Column="1"
                         Margin="10,0,0,0"
                         Padding="8,5"
                         IsReadOnly="True"
                         Text="{Binding AttachedTxdDisplayName, Mode=OneWay}" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding TxdAttachmentStatus}" />
                <TextBlock Grid.Column="3"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           Text="{loc:Translate Main.TxdAvailability}" />
                <Button Grid.Column="4"
                        MinWidth="110"
                        Style="{StaticResource CompactCommandButtonStyle}"
                        Content="{loc:Translate Main.TxdAttach}"
                        Command="{Binding AddTxdCommand}" />
                <Button Grid.Column="5"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Style="{StaticResource CompactDropDownButtonStyle}"
                        Content="{loc:Translate Main.Actions}"
                        IsEnabled="{Binding HasTxdAttachment}"
                        ToolTip="{loc:Translate Main.TxdActions.ToolTip}"
                        Click="DropDownButton_OnClick">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource CommandContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource CommandMenuItemStyle}"
                                      Header="{loc:Translate Main.Mapping}"
                                      Command="{Binding ViewTxdCommand}" />
                            <Separator />
                            <MenuItem Style="{StaticResource DangerCommandMenuItemStyle}"
                                      Header="{loc:Translate Main.TxdRemove}"
                                      Command="{Binding RemoveTxdCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,0,0,12"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{loc:Translate Main.InstallerWindows}" />
                <TextBox Grid.Column="1"
                         Margin="10,0,0,0"
                         Padding="8,5"
                         IsReadOnly="True"
                         Text="{Binding InstallerProfileStatus, Mode=OneWay}" />
                <TextBlock Grid.Column="2"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           Text="{loc:Translate Main.InstallerAvailability}" />
                <Button Grid.Column="3"
                        MinWidth="110"
                        Style="{StaticResource CompactCommandButtonStyle}"
                        Content="{loc:Translate Main.InstallerConfigure}"
                        Command="{Binding ConfigureInstallerCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,0,0,12"
                Padding="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         MinHeight="34"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         ToolTip="{loc:Translate Main.Search.ToolTip}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1"
                          Margin="10,0,0,0"
                          Padding="8,5"
                          ItemsSource="{Binding SearchColumns}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedSearchColumn}" />
                <CheckBox Grid.Column="2"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="{loc:Translate Main.CaseSensitive}"
                          IsChecked="{Binding CaseSensitive}" />
                <CheckBox Grid.Column="3"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="{loc:Translate Main.LiveSearch}"
                          IsChecked="{Binding LiveSearch}" />
                <Button Grid.Column="4"
                        MinWidth="90"
                        Margin="14,0,0,0"
                        Padding="12,6"
                        Content="{loc:Translate Main.Find}"
                        Command="{Binding ApplyFilterCommand}" />
                <Button Grid.Column="5"
                        MinWidth="90"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Content="{loc:Translate Common.Reset}"
                        Command="{Binding ClearSearchCommand}" />

                <Grid Grid.Row="1" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="{loc:Translate Main.BlockType}" />
                    <ComboBox Grid.Column="1"
                              Margin="8,0,18,0"
                              Padding="8,5"
                              ItemsSource="{Binding MetadataTypeOptions}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedMetadataType}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{loc:Translate Main.Block}" />
                    <ComboBox Grid.Column="3"
                              Margin="8,0,18,0"
                              Padding="8,5"
                              ItemsSource="{Binding MetadataBlockOptions}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedMetadataBlock}" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{loc:Translate Main.Order}" />
                    <ComboBox Grid.Column="5"
                              Margin="8,0,0,0"
                              Padding="8,5"
                              ItemsSource="{Binding SortOptions}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSortOption}" />
                    <TextBlock Grid.Column="6"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding FilteredEntriesText}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="EntriesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      ItemsSource="{Binding EntriesView}"
                      MouseDoubleClick="EntriesGrid_OnMouseDoubleClick"
                      SelectedItem="{Binding SelectedEntry}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="160"
                                        Header="{loc:Translate Main.Key}"
                                        Binding="{Binding Name}" />
                    <DataGridTemplateColumn Width="90" Header="{loc:Translate Main.Reviewed}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsReviewed, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleReviewedCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="2*"
                                        Header="{loc:Translate Main.Translation}"
                                        Binding="{Binding Text}" />
                    <DataGridTemplateColumn Width="260" Header="{loc:Translate Main.Encounter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding EncounterSummary}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding EncounterToolTip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="190"
                                        Header="{loc:Translate Main.Comment}"
                                        Binding="{Binding CommentPreview}" />
                    <DataGridTextColumn Width="130"
                                        Header="{loc:Translate Main.Table}"
                                        Binding="{Binding Table}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="{loc:Translate Main.EnglishSource}" />
                        <TextBox Grid.Row="1"
                                 Padding="8"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedEntry.SourceText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="{loc:Translate Main.Occurrences}" />
                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding SelectedEntry.Occurrences}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.2*" Header="{loc:Translate Main.Block}" Binding="{Binding BlockName}" />
                                <DataGridTextColumn Width="85" Header="{loc:Translate Main.Order}" Binding="{Binding OrderText}" />
                                <DataGridTextColumn Width="1.4*" Header="{loc:Translate Main.Context}" Binding="{Binding Context}" />
                                <DataGridTextColumn Width="80" Header="{loc:Translate Main.Source}" Binding="{Binding SourceName}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="{loc:Translate Main.TranslatorComment}" />
                        <TextBox Grid.Row="1"
                                 Padding="8"
                                 AcceptsReturn="True"
                                 Text="{Binding CommentDraft, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <StackPanel Grid.Row="2"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button MinWidth="90"
                                    Padding="10,5"
                                    Content="{loc:Translate Common.Clear}"
                                    Command="{Binding ClearCommentCommand}" />
                            <Button MinWidth="100"
                                    Margin="8,0,0,0"
                                    Padding="10,5"
                                    Content="{loc:Translate Common.Save}"
                                    Command="{Binding SaveCommentCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="6" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="110"
                    Padding="12,7"
                    Content="{loc:Translate Common.Add}"
                    Command="{Binding AddEntryCommand}" />
            <Button Grid.Column="1"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="{loc:Translate Common.Edit}"
                    Command="{Binding EditEntryCommand}" />
            <Button Grid.Column="2"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="{loc:Translate Common.Delete}"
                    Command="{Binding DeleteEntryCommand}" />
            <Button Grid.Column="4"
                    MinWidth="190"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="{loc:Translate Main.Comparison}"
                    Command="{Binding OpenComparisonFileCommand}" />
            <Button Grid.Column="5"
                    MinWidth="190"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="{loc:Translate Main.AddFromGxt}"
                    Command="{Binding AddMissingEntriesCommand}" />
            <Button Grid.Column="6"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="{loc:Translate Main.ConvertMapping}"
                    Command="{Binding ConvertDictionaryCommand}" />
        </Grid>

        <StatusBar Grid.Row="7">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar Width="72"
                                 Height="4"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True" />
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="{Binding BusyText}" />
                    <Button Padding="8,2"
                            Content="{loc:Translate Common.Cancel}"
                            Command="{Binding CancelOperationCommand}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
