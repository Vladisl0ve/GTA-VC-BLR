<Window x:Class="GTA_GXT_Editor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA GXT Editor"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding ImportJsonCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportJsonCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ApplyFilterCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
    </Window.InputBindings>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Grid Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button MinWidth="91"
                            Padding="12,8"
                            Content="Открыть…"
                            ToolTip="Открыть GXT с автоматическим выбором кодировки (Ctrl+O)"
                            Command="{Binding OpenFileCommand}" />
                    <ToggleButton x:Name="OpenFileOptionsButton"
                                  Grid.Column="1"
                                  Width="28"
                                  Margin="1,0,0,0"
                                  Padding="0"
                                  Content="▾"
                                  ToolTip="Дополнительные варианты открытия" />
                    <Popup Grid.ColumnSpan="2"
                           AllowsTransparency="True"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                           IsOpen="{Binding IsChecked, ElementName=OpenFileOptionsButton, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=OpenFileOptionsButton}"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Padding="4"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Button Padding="12,7"
                                    HorizontalContentAlignment="Left"
                                    Content="Открыть со словарём…"
                                    Command="{Binding OpenFileWithDictionaryCommand}" />
                        </Border>
                    </Popup>
                </Grid>

                <Grid Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button MinWidth="101"
                            Padding="12,8"
                            Content="JSON → GXT…"
                            ToolTip="Преобразовать JSON в GXT с автоматическим выбором кодировки (Ctrl+Shift+I)"
                            Command="{Binding ImportJsonCommand}" />
                    <ToggleButton x:Name="ImportJsonOptionsButton"
                                  Grid.Column="1"
                                  Width="28"
                                  Margin="1,0,0,0"
                                  Padding="0"
                                  Content="▾"
                                  ToolTip="Дополнительные варианты преобразования" />
                    <Popup Grid.ColumnSpan="2"
                           AllowsTransparency="True"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                           IsOpen="{Binding IsChecked, ElementName=ImportJsonOptionsButton, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ImportJsonOptionsButton}"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Padding="4"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Button Padding="12,7"
                                    HorizontalContentAlignment="Left"
                                    Content="JSON → GXT со словарём…"
                                    Command="{Binding ImportJsonWithDictionaryCommand}" />
                        </Border>
                    </Popup>
                </Grid>

                <Button MinWidth="110"
                         Margin="8,0,0,0"
                         Padding="14,8"
                         Content="Сохранить"
                         ToolTip="Сохранить GXT или текущий проект BYX (Ctrl+S)"
                         Command="{Binding SaveCommand}" />
                <Button MinWidth="140"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        Content="Экспорт JSON…"
                        ToolTip="Экспортировать все записи в JSON (Ctrl+Shift+E)"
                        Command="{Binding ExportJsonCommand}" />
            </StackPanel>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="GTA GXT Editor" />
                <TextBlock Margin="0,4,0,0"
                           Opacity="0.7"
                           Text="Редактор текстовых ресурсов GTA III и Vice City" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="GXT-файл" />
            <TextBox Grid.Column="1"
                     MinHeight="34"
                     Padding="10,6"
                     IsReadOnly="True"
                     Text="{Binding GxtPath}" />
            <Border Grid.Column="2"
                    Margin="10,0,0,0"
                    Padding="12,6"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <TextBlock VerticalAlignment="Center" Text="{Binding DocumentType}" />
            </Border>
            <Button Grid.Column="3"
                    MinWidth="110"
                    Margin="10,0,0,0"
                    Padding="12,6"
                     Content="Перезагрузить"
                     Command="{Binding ReloadCommand}" />

            <TextBlock Grid.Row="1"
                       Margin="0,10,10,0"
                       VerticalAlignment="Center"
                       Text="Проект BYX" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="3"
                     Margin="0,10,0,0"
                     MinHeight="34"
                     Padding="10,6"
                     IsReadOnly="True"
                     ToolTip="Пусто, пока проект не сохранён в BYX"
                     Text="{Binding ProjectPath}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Шрифты TXD" />
                <ComboBox Grid.Column="1"
                          Margin="10,0,0,0"
                          Padding="8,5"
                          ItemsSource="{Binding TxdAttachments}"
                          SelectedItem="{Binding SelectedTxd}"
                          DisplayMemberPath="DisplayName" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding TxdAttachments.Count, StringFormat='Подключено: {0}'}" />
                <TextBlock Grid.Column="3"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           Text="TXD доступны только для GTA Vice City PC" />
                <Button Grid.Column="4"
                        MinWidth="110"
                        Padding="12,6"
                        Content="Добавить TXD…"
                        Command="{Binding AddTxdCommand}" />
                <Button Grid.Column="5"
                        MinWidth="110"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Content="Просмотреть"
                        Command="{Binding ViewTxdCommand}" />
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="6"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button MinWidth="90"
                            Padding="12,6"
                            Content="Удалить"
                            Command="{Binding RemoveTxdCommand}" />
                    <Button MinWidth="110"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Content="Экспорт TXD…"
                            Command="{Binding ExportTxdCommand}" />
                    <Button MinWidth="110"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Content="Экспорт GXT…"
                            Command="{Binding ExportGxtCommand}" />
                    <Button MinWidth="120"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            Content="Проект как…"
                            Command="{Binding SaveProjectAsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,0,0,12"
                Padding="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         MinHeight="34"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         ToolTip="Поиск по ключам, тексту и таблицам"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1"
                          Margin="10,0,0,0"
                          Padding="8,5"
                          ItemsSource="{Binding SearchColumns}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedSearchColumn}" />
                <CheckBox Grid.Column="2"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="Учитывать регистр"
                          IsChecked="{Binding CaseSensitive}" />
                <CheckBox Grid.Column="3"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="Живой поиск"
                          IsChecked="{Binding LiveSearch}" />
                <Button Grid.Column="4"
                        MinWidth="90"
                        Margin="14,0,0,0"
                        Padding="12,6"
                        Content="Найти"
                        Command="{Binding ApplyFilterCommand}" />
                <Button Grid.Column="5"
                        MinWidth="90"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Content="Сбросить"
                        Command="{Binding ClearSearchCommand}" />
            </Grid>
        </Border>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  ItemsSource="{Binding EntriesView}"
                  MouseDoubleClick="EntriesGrid_OnMouseDoubleClick"
                  SelectedItem="{Binding SelectedEntry}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Width="220"
                                    Header="Ключ"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Width="2*"
                                    Header="Текст"
                                    Binding="{Binding Text}" />
                <DataGridTextColumn Width="160"
                                    Header="Таблица"
                                    Binding="{Binding Table}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="110"
                    Padding="12,7"
                    Content="Добавить"
                    Command="{Binding AddEntryCommand}" />
            <Button Grid.Column="1"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Изменить"
                    Command="{Binding EditEntryCommand}" />
            <Button Grid.Column="2"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Удалить"
                    Command="{Binding DeleteEntryCommand}" />
            <Button Grid.Column="4"
                    MinWidth="190"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Добавить для сравнения…"
                    Command="{Binding OpenComparisonFileCommand}" />
            <Button Grid.Column="5"
                    MinWidth="190"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Добавить из другого GXT…"
                    Command="{Binding AddMissingEntriesCommand}" />
            <Button Grid.Column="6"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Преобразовать словарь…"
                    Command="{Binding ConvertDictionaryCommand}" />
        </Grid>

        <StatusBar Grid.Row="6">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
