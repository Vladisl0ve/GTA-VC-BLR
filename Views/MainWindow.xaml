<Window x:Class="GTA_GXT_Editor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA GXT Editor"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Icon="/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ApplyFilterCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
    </Window.InputBindings>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        Content="Открыть…"
                        Command="{Binding OpenFileCommand}" />
                <Button MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        Content="Сохранить как…"
                        Command="{Binding SaveCommand}" />
            </StackPanel>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="GTA GXT Editor" />
                <TextBlock Margin="0,4,0,0"
                           Opacity="0.7"
                           Text="Редактор текстовых ресурсов GTA III и Vice City" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="GXT-файл" />
            <TextBox Grid.Column="1"
                     MinHeight="34"
                     Padding="10,6"
                     IsReadOnly="True"
                     Text="{Binding GxtPath}" />
            <Border Grid.Column="2"
                    Margin="10,0,0,0"
                    Padding="12,6"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <TextBlock VerticalAlignment="Center" Text="{Binding DocumentType}" />
            </Border>
            <Button Grid.Column="3"
                    MinWidth="110"
                    Margin="10,0,0,0"
                    Padding="12,6"
                    Content="Перезагрузить"
                    Command="{Binding ReloadCommand}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         MinHeight="34"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         ToolTip="Поиск по ключам, тексту и таблицам"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1"
                          Margin="10,0,0,0"
                          Padding="8,5"
                          ItemsSource="{Binding SearchColumns}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding SelectedSearchColumn}" />
                <CheckBox Grid.Column="2"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="Учитывать регистр"
                          IsChecked="{Binding CaseSensitive}" />
                <CheckBox Grid.Column="3"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          Content="Живой поиск"
                          IsChecked="{Binding LiveSearch}" />
                <Button Grid.Column="4"
                        MinWidth="90"
                        Margin="14,0,0,0"
                        Padding="12,6"
                        Content="Найти"
                        Command="{Binding ApplyFilterCommand}" />
                <Button Grid.Column="5"
                        MinWidth="90"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Content="Сбросить"
                        Command="{Binding ClearSearchCommand}" />
            </Grid>
        </Border>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  ItemsSource="{Binding EntriesView}"
                  MouseDoubleClick="EntriesGrid_OnMouseDoubleClick"
                  SelectedItem="{Binding SelectedEntry}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Width="220"
                                    Header="Ключ"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Width="2*"
                                    Header="Текст"
                                    Binding="{Binding Text}" />
                <DataGridTextColumn Width="160"
                                    Header="Таблица"
                                    Binding="{Binding Table}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="110"
                    Padding="12,7"
                    Content="Добавить"
                    Command="{Binding AddEntryCommand}" />
            <Button Grid.Column="1"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Изменить"
                    Command="{Binding EditEntryCommand}" />
            <Button Grid.Column="2"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Удалить"
                    Command="{Binding DeleteEntryCommand}" />
            <Button Grid.Column="4"
                    MinWidth="190"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Добавить из другого GXT…"
                    Command="{Binding AddMissingEntriesCommand}" />
            <Button Grid.Column="5"
                    MinWidth="200"
                    Margin="8,0,0,0"
                    Padding="12,7"
                    Content="Преобразовать словарь…"
                    Command="{Binding ConvertDictionaryCommand}" />
        </Grid>

        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
