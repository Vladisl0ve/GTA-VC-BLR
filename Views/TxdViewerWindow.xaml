<Window x:Class="GTA_GXT_Editor.Views.TxdViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр шрифтов TXD"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Icon="/icon.ico"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE8E8E8">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFCCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="TXD-файлы" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Attachments}"
                     SelectedItem="{Binding SelectedAttachment}"
                     DisplayMemberPath="DisplayName" />
            <TextBlock Grid.Row="2" Margin="0,14,0,8" FontWeight="SemiBold" Text="Текстуры" />
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Textures}"
                     SelectedItem="{Binding SelectedTexture}"
                     DisplayMemberPath="Name" />
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2" Margin="12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="280" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Текстура целиком" />
            <Border Grid.Row="1" Background="{StaticResource CheckerBrush}" BorderThickness="1" BorderBrush="#808080">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image Source="{Binding TextureImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="2"
                       Margin="0,10,0,12"
                       TextWrapping="Wrap"
                       Text="{Binding TextureMetadata}" />
            <Border Grid.Row="3" Background="{StaticResource CheckerBrush}" BorderThickness="1" BorderBrush="#808080">
                <Image Source="{Binding GlyphImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
        </Grid>

        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

        <Grid Grid.Column="4" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,8"
                       FontWeight="SemiBold"
                       Text="Символы font1 / font2 / pager" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Glyphs}"
                     SelectedItem="{Binding SelectedGlyph}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="74" Margin="3">
                            <Border Width="58"
                                    Height="58"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource CheckerBrush}"
                                    BorderBrush="#808080"
                                    BorderThickness="1">
                                <Image Source="{Binding Image}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
