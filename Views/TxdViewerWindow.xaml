<Window x:Class="GTA_GXT_Editor.Views.TxdViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GTA_GXT_Editor.Localization"
        Title="{loc:Translate Txd.Title}"
        Width="1240"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        Icon="/icon.ico"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE8E8E8">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFCCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGameFontPreviewAvailable}" Value="False">
                                <Setter Property="Height" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="230" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGameFontPreviewAvailable}" Value="False">
                                <Setter Property="Height" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding Attachment.DisplayName, StringFormat='TXD: {0}'}" />
                <TextBlock Margin="0,3,0,0" Opacity="0.7" Text="{Binding VerificationText}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="8,0,0,0" Padding="12,6" Content="{loc:Translate Txd.Import}"
                        Command="{Binding ImportProfileCommand}" />
                <Button Margin="8,0,0,0" Padding="12,6" Content="{loc:Translate Txd.Export}"
                        Command="{Binding ExportProfileCommand}" />
                <Button Margin="8,0,0,0" Padding="12,6" Content="{loc:Translate Txd.BelarusianPreset}"
                        Command="{Binding UseBelarusianPresetCommand}" />
                <Button Margin="8,0,0,0" Padding="12,6" Content="{loc:Translate Common.Reset}"
                        Command="{Binding ResetProfileCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="285" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{loc:Translate Txd.Textures}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture}"
                         DisplayMemberPath="Name" />
                <TextBlock Grid.Row="2" Margin="0,12,0,8" FontWeight="SemiBold" Text="{loc:Translate Txd.FullTexture}" />
                <Border Grid.Row="3" Background="{StaticResource CheckerBrush}" BorderThickness="1" BorderBrush="#808080">
                    <Image Source="{Binding TextureImage}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Grid.Row="4" Margin="0,8,0,8" TextWrapping="Wrap" Text="{Binding TextureMetadata}" />
                <Border Grid.Row="5" MinHeight="80" Background="{StaticResource CheckerBrush}"
                        BorderThickness="1" BorderBrush="#808080">
                    <Image Source="{Binding GlyphImage}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2" Margin="12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding GlyphAtlasHeading}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Glyphs}" SelectedItem="{Binding SelectedGlyph}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="78" Margin="3">
                                <Border Width="58" Height="58" HorizontalAlignment="Center"
                                        Background="{StaticResource CheckerBrush}" BorderBrush="#808080" BorderThickness="1">
                                    <Image Source="{Binding Image}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="4" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{loc:Translate Txd.SelectedCell}" />
                <TextBox Grid.Row="1" Margin="0,8,0,0" Padding="8,6" MaxLength="1"
                         Text="{Binding AssignmentText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                    <Button MinWidth="90" Padding="10,5" Content="{loc:Translate Txd.Assign}" Command="{Binding AssignCommand}" />
                    <Button MinWidth="80" Margin="8,0,0,0" Padding="10,5" Content="{loc:Translate Common.Clear}"
                            Command="{Binding ClearAssignmentCommand}" />
                </StackPanel>
                <Button Grid.Row="3" Margin="0,8,0,0" Padding="10,5" HorizontalAlignment="Stretch"
                        Content="{loc:Translate Txd.MakePreferred}" Command="{Binding MakePreferredCommand}" />
                <CheckBox Grid.Row="4" Margin="0,8,0,10" IsHitTestVisible="False"
                          IsChecked="{Binding IsPreferredCode}" Content="{loc:Translate Txd.PreferredCode}" />
                <GroupBox Grid.Row="5" Header="{loc:Translate Txd.Validation}">
                    <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                        <TextBlock TextWrapping="Wrap" Text="{Binding AnalysisText}" />
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" ResizeDirection="Rows"
                      Visibility="{Binding IsGameFontPreviewAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <GroupBox Grid.Row="3" Margin="0,8,0,0" Header="{loc:Translate Txd.Preview.Title}"
                  Visibility="{Binding IsGameFontPreviewAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                               Text="{loc:Translate Txd.Preview.Text}" />
                    <TextBox Width="330" Margin="0,0,12,0" Padding="6,3"
                             Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                               Text="{loc:Translate Txd.Preview.Style}" />
                    <ComboBox Width="145" Margin="0,0,12,0" Padding="6,3"
                              ItemsSource="{Binding FontStyles}"
                              SelectedItem="{Binding SelectedFontStyle}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                               Text="{loc:Translate Txd.Preview.Context}" />
                    <ComboBox Width="145" Margin="0,0,12,0" Padding="6,3"
                              ItemsSource="{Binding RenderContexts}"
                              SelectedItem="{Binding SelectedRenderContext}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center"
                               Text="{loc:Translate Txd.Preview.Scale}" />
                    <ComboBox Width="70" Margin="0,0,12,0" Padding="6,3"
                              ItemsSource="{Binding PreviewScales}"
                              SelectedItem="{Binding SelectedPreviewScale}"
                              DisplayMemberPath="DisplayName" />
                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center"
                              IsChecked="{Binding ShowMetricGuides}"
                              Content="{loc:Translate Txd.Preview.ShowGuides}" />
                    <Menu VerticalAlignment="Center">
                        <MenuItem Header="{loc:Translate Txd.Metrics.Menu}">
                            <MenuItem Header="{loc:Translate Txd.Metrics.Import}"
                                      Command="{Binding ImportFontMetricsCommand}" />
                            <MenuItem Header="{loc:Translate Txd.Metrics.Export}"
                                      Command="{Binding ExportFontMetricsCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Translate Txd.Metrics.UseBelarusian}"
                                      Command="{Binding UseBelarusianFontMetricsCommand}" />
                            <MenuItem Header="{loc:Translate Txd.Metrics.Reset}"
                                      Command="{Binding ResetFontMetricsCommand}" />
                        </MenuItem>
                    </Menu>
                </WrapPanel>

                <Border Grid.Row="1" Background="{StaticResource CheckerBrush}"
                        BorderBrush="#808080" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding PreviewImage}" Stretch="None"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </ScrollViewer>
                </Border>

                <GroupBox Grid.Row="1" Grid.Column="2" Header="{loc:Translate Txd.Preview.SelectedGlyphDebug}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Translate Txd.Preview.Character}" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedGlyphCharacter}" />
                        <TextBlock Grid.Row="1" Text="{loc:Translate Txd.Preview.Code}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                                   Text="{Binding SelectedGlyphCode, StringFormat=0x{0:X2}}" />
                        <TextBlock Grid.Row="2" Text="{loc:Translate Txd.Preview.MetricIndex}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedMetricIndex}" />
                        <TextBlock Grid.Row="3" Text="{loc:Translate Txd.Preview.Font1Advance}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedFont1Advance}" />
                        <TextBlock Grid.Row="4" Text="{loc:Translate Txd.Preview.Font2Advance}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedFont2Advance}" />
                        <TextBlock Grid.Row="5" Text="{loc:Translate Txd.Preview.Context}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="8,0,0,0"
                                   Text="{Binding SelectedRenderContext.DisplayName}" />
                        <TextBlock Grid.Row="6" Text="{loc:Translate Txd.Preview.SelectedFont}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedFont}" />
                        <TextBlock Grid.Row="7" Text="{loc:Translate Txd.Preview.BaseAdvance}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedBaseAdvance}" />
                        <TextBlock Grid.Row="8" Text="{loc:Translate Txd.Preview.ContextOverride}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Margin="8,0,0,0"
                                   Text="{Binding SelectedContextOverrideAdvance}" />
                        <TextBlock Grid.Row="9" FontWeight="SemiBold"
                                   Text="{loc:Translate Txd.Preview.EffectiveAdvance}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Margin="8,0,0,0" FontWeight="SemiBold"
                                   Text="{Binding SelectedEffectiveAdvance}" />
                        <ScrollViewer Grid.Row="10" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock Opacity="0.75" TextWrapping="Wrap" Text="{Binding PreviewStatus}" />
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <ComboBox Width="285" Padding="8,5" ItemsSource="{Binding ApplyModes}"
                      SelectedItem="{Binding SelectedApplyMode}" DisplayMemberPath="DisplayName" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="100" Padding="12,6" Content="{loc:Translate Common.Cancel}" IsCancel="True" />
                <Button Width="120" Margin="8,0,0,0" Padding="12,6" Content="{loc:Translate Txd.Check}"
                        IsDefault="True" Command="{Binding ApplyCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
